{
  "manifest_version": 3,
  "name": "AI Research Assistant",
  "version": "1.1",
  "description": "Save pages and chat with your research via RAG.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Research Assistant"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "chat-ui/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
